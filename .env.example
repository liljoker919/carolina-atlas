# Carolina Atlas — Environment Variables
# Copy this file to .env.local and fill in values as needed.
# NEVER commit .env.local to version control.

# ─── Raleigh Police Incidents API ────────────────────────────────────────────
# Base URL for the ArcGIS FeatureServer query endpoint.
# Defaults to the public City of Raleigh endpoint if not set.
NEXT_PUBLIC_RALEIGH_INCIDENTS_API_URL=https://services.arcgis.com/v400IkDOw1ad7Yad/arcgis/rest/services/Daily_Police_Incidents/FeatureServer/0/query

# ─── Future API keys (not yet required) ─────────────────────────────────────
# NEXT_PUBLIC_MAPBOX_TOKEN=
# CENSUS_API_KEY=
# NCDPI_API_KEY=
